# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to GitHub.

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/volunteer_system

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Email (used for OTP + notifications) - example uses Gmail SMTP via App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=usmanadamuusman94@gmail.com
EMAIL_PASS=your_gmail_app_password

# Seed admin account (only used once, by npm run seed:admin)
ADMIN_EMAIL=usmanadamuusman94@gmail.com
ADMIN_PASSWORD=usmana2004
ADMIN_NAME=System Administrator
